elseif(TEST_CASE STREQUAL "dda_hierarchy_characterization")
    set(ENABLE_DDA_METRICS_SUMMARY ON)
    set(USE_AUTO_EXIT_FRAMES ON)
    set(AUTO_EXIT_FRAMES "4")
    run_runtime("0" "${run_dir}" "${staged_executable}" "${runtime_asset_root}" "${runtime_scenes_root}")
    require_log_contains("${log_path}" "[INFO][Automation] DDA metrics dump enabled for this run.")
    require_log_contains("${log_path}" "[INFO][Automation] First frame rendered.")
    require_log_contains("${log_path}"
        "[INFO][Automation] DDA metrics summary for scene '${SCENE_NAME}':")
    require_log_contains("${log_path}" "skipEnabled=true")
    require_log_contains("${log_path}" "skipMip=3")
    require_log_contains("${log_path}" "stride=4")
    set(minimum_hit_rate 99.00)
    set(minimum_samples 5000)
    set(maximum_skip_jumps 8.00)
    set(maximum_fine_iterations 3.00)
    if(SCENE_NAME MATCHES "^nature_pond")
        # primary obb face culling records each (pixel, volume) traversal once.
        # Instanced meadow foliage is no longer a DDA sample, so the retained
        # terrain/detail/hero bank-camera population is ~4.2k samples at the
        # no-editor extent and has a 44-66% hit rate across the two extents.
        set(minimum_hit_rate 40.00)
        set(minimum_samples 4000)
        set(maximum_skip_jumps 10.00)
        set(maximum_fine_iterations 10.00)
    endif()
    require_log_numeric_range("${log_path}" "samples"
        "DDA metrics summary[^\n]*samples=([0-9]+)" ${minimum_samples} 350000)
    require_log_numeric_range("${log_path}" "hitRatePercent"
        "DDA metrics summary[^\n]*hitRate=([0-9]+\\.[0-9]+)%" ${minimum_hit_rate} 100.00)
    require_log_numeric_range("${log_path}" "avgSkipJumps"
        "DDA metrics summary[^\n]*avgSkipJumps=([0-9]+\\.[0-9]+)" 1.00 ${maximum_skip_jumps})
    require_log_numeric_range("${log_path}" "avgFineIterations"
        "DDA metrics summary[^\n]*avgFineIterations=([0-9]+\\.[0-9]+)" 0.50 ${maximum_fine_iterations})
    require_log_numeric_range("${log_path}" "avgHierarchyProbes"
        "DDA metrics summary[^\n]*avgHierarchyProbes=([0-9]+\\.[0-9]+)" 1.00 20.00)

    file(READ "${log_path}" hierarchy_log)
    string(REGEX MATCH
        "DDA metrics summary[^\n]*samples=([0-9]+)[^\n]*hitSignature=\\(([0-9]+),([0-9]+)\\)[^\n]*surfaceSignature=\\(([0-9]+),([0-9]+)\\)"
        hierarchy_signature_match "${hierarchy_log}")
    if(hierarchy_signature_match STREQUAL "")
        message(FATAL_ERROR "Failed to parse hierarchy output signatures from ${log_path}")
    endif()
    set(hierarchy_samples "${CMAKE_MATCH_1}")
    set(hierarchy_hit_xor "${CMAKE_MATCH_2}")
    set(hierarchy_hit_sum "${CMAKE_MATCH_3}")
    set(hierarchy_surface_xor "${CMAKE_MATCH_4}")
    set(hierarchy_surface_sum "${CMAKE_MATCH_5}")
    file(COPY_FILE "${log_path}" "${run_dir}/candidate_stdout.txt")

    file(REMOVE "${log_path}")
    set(DISABLE_EMPTY_SKIP ON)
    run_runtime("0" "${run_dir}" "${staged_executable}" "${runtime_asset_root}" "${runtime_scenes_root}")
    require_log_contains("${log_path}" "skipEnabled=false")

    file(READ "${log_path}" reference_log)
    string(REGEX MATCH
        "DDA metrics summary[^\n]*samples=([0-9]+)[^\n]*hitSignature=\\(([0-9]+),([0-9]+)\\)[^\n]*surfaceSignature=\\(([0-9]+),([0-9]+)\\)"
        reference_signature_match "${reference_log}")
    if(reference_signature_match STREQUAL "")
        message(FATAL_ERROR "Failed to parse legacy output signatures from ${log_path}")
    endif()
    file(COPY_FILE "${log_path}" "${run_dir}/reference_stdout.txt")
    if(NOT hierarchy_samples STREQUAL "${CMAKE_MATCH_1}" OR
       NOT hierarchy_hit_xor STREQUAL "${CMAKE_MATCH_2}" OR
       NOT hierarchy_hit_sum STREQUAL "${CMAKE_MATCH_3}" OR
       NOT hierarchy_surface_xor STREQUAL "${CMAKE_MATCH_4}" OR
       NOT hierarchy_surface_sum STREQUAL "${CMAKE_MATCH_5}")
        message(FATAL_ERROR
            "Hierarchy output signature differs from the legacy reference.\n"
            "Hierarchy: samples=${hierarchy_samples} hit=(${hierarchy_hit_xor},${hierarchy_hit_sum}) "
            "surface=(${hierarchy_surface_xor},${hierarchy_surface_sum})\n"
            "Reference: samples=${CMAKE_MATCH_1} hit=(${CMAKE_MATCH_2},${CMAKE_MATCH_3}) "
            "surface=(${CMAKE_MATCH_4},${CMAKE_MATCH_5})\n")
    endif()
