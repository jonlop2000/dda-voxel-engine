function(stage_runtime BUILD_DIR EXECUTABLE_PATH RUN_DIR ASSET_ROOT SCENES_ROOT)
    file(REMOVE_RECURSE "${RUN_DIR}")
    file(MAKE_DIRECTORY "${RUN_DIR}")
    file(MAKE_DIRECTORY "${RUN_DIR}/logs")

    get_filename_component(exe_name "${EXECUTABLE_PATH}" NAME)
    file(COPY_FILE "${EXECUTABLE_PATH}" "${RUN_DIR}/${exe_name}")

    file(GLOB runtime_libs
        LIST_DIRECTORIES false
        "${BUILD_DIR}/*.dll"
        "${BUILD_DIR}/*.dylib"
        "${BUILD_DIR}/*.so"
        "${BUILD_DIR}/*.so.*")
    foreach(runtime_lib IN LISTS runtime_libs)
        get_filename_component(runtime_lib_name "${runtime_lib}" NAME)
        file(COPY_FILE "${runtime_lib}" "${RUN_DIR}/${runtime_lib_name}")
    endforeach()

    if(EXISTS "${BUILD_DIR}/shaders")
        file(COPY "${BUILD_DIR}/shaders" DESTINATION "${RUN_DIR}")
    else()
        message(FATAL_ERROR "Runtime shader directory is missing: ${BUILD_DIR}/shaders")
    endif()

    if(EXISTS "${ASSET_ROOT}")
        file(COPY "${ASSET_ROOT}" DESTINATION "${RUN_DIR}")
    else()
        message(FATAL_ERROR "Asset root is missing: ${ASSET_ROOT}")
    endif()

    if(EXISTS "${SCENES_ROOT}")
        file(COPY "${SCENES_ROOT}" DESTINATION "${RUN_DIR}")
    else()
        message(FATAL_ERROR "Scenes root is missing: ${SCENES_ROOT}")
    endif()
endfunction()

function(require_log_contains LOG_PATH EXPECTED_TEXT)
    if(NOT EXISTS "${LOG_PATH}")
        message(FATAL_ERROR "Expected log file was not written: ${LOG_PATH}")
    endif()

    file(READ "${LOG_PATH}" log_contents)
    string(FIND "${log_contents}" "${EXPECTED_TEXT}" found_index)
    if(found_index EQUAL -1)
        message(FATAL_ERROR
            "Expected log text not found.\nLog: ${LOG_PATH}\nNeedle: ${EXPECTED_TEXT}\n")
    endif()
endfunction()

function(require_log_not_contains LOG_PATH UNEXPECTED_TEXT)
    if(NOT EXISTS "${LOG_PATH}")
        message(FATAL_ERROR "Expected log file was not written: ${LOG_PATH}")
    endif()

    file(READ "${LOG_PATH}" log_contents)
    string(FIND "${log_contents}" "${UNEXPECTED_TEXT}" found_index)
    if(NOT found_index EQUAL -1)
        message(FATAL_ERROR
            "Unexpected log text found.\nLog: ${LOG_PATH}\nNeedle: ${UNEXPECTED_TEXT}\n")
    endif()
endfunction()

function(require_log_order LOG_PATH FIRST_TEXT SECOND_TEXT)
    if(NOT EXISTS "${LOG_PATH}")
        message(FATAL_ERROR "Expected log file was not written: ${LOG_PATH}")
    endif()

    file(READ "${LOG_PATH}" log_contents)
    string(FIND "${log_contents}" "${FIRST_TEXT}" first_index)
    string(FIND "${log_contents}" "${SECOND_TEXT}" second_index)
    if(first_index EQUAL -1 OR second_index EQUAL -1)
        message(FATAL_ERROR
            "Expected log order text not found.\nLog: ${LOG_PATH}\nFirst: ${FIRST_TEXT}\nSecond: ${SECOND_TEXT}\n")
    endif()
    if(first_index GREATER second_index)
        message(FATAL_ERROR
            "Expected log text order was reversed.\nLog: ${LOG_PATH}\nFirst: ${FIRST_TEXT}\nSecond: ${SECOND_TEXT}\n")
    endif()
endfunction()

function(require_log_numeric_range LOG_PATH LABEL REGEX MIN_VALUE MAX_VALUE)
    if(NOT EXISTS "${LOG_PATH}")
        message(FATAL_ERROR "Expected log file was not written: ${LOG_PATH}")
    endif()

    file(READ "${LOG_PATH}" log_contents)
    string(REGEX MATCH "${REGEX}" metric_match "${log_contents}")
    if(metric_match STREQUAL "")
        message(FATAL_ERROR
            "Expected numeric metric not found.\nLog: ${LOG_PATH}\nMetric: ${LABEL}\nRegex: ${REGEX}\n")
    endif()

    set(metric_value "${CMAKE_MATCH_1}")
    if(metric_value LESS MIN_VALUE OR metric_value GREATER MAX_VALUE)
        message(FATAL_ERROR
            "Numeric metric outside expected range.\nLog: ${LOG_PATH}\nMetric: ${LABEL}\n"
            "Value: ${metric_value}\nExpected: ${MIN_VALUE}..${MAX_VALUE}\n")
    endif()
endfunction()

function(require_foliage_time_relation LOG_PATH EXPECT_DIFFERENT)
    file(READ "${LOG_PATH}" foliage_log)
    string(REGEX MATCH
        "foliageCurrentTime=([-+0-9.eE]+), foliagePreviousTime=([-+0-9.eE]+)"
        foliage_time_match "${foliage_log}")
    if(foliage_time_match STREQUAL "")
        message(FATAL_ERROR "Foliage current/previous times were not reported")
    endif()
    set(foliage_current_time "${CMAKE_MATCH_1}")
    set(foliage_previous_time "${CMAKE_MATCH_2}")
    if(EXPECT_DIFFERENT AND foliage_current_time STREQUAL foliage_previous_time)
        message(FATAL_ERROR
            "Live foliage motion retained identical current/previous times")
    elseif(NOT EXPECT_DIFFERENT AND
           NOT foliage_current_time STREQUAL foliage_previous_time)
        message(FATAL_ERROR
            "Frozen foliage motion retained different current/previous times")
    endif()
endfunction()

function(require_instanced_foliage_geometry LOG_PATH MIN_INSTANCE_COUNT
         MAX_INSTANCE_COUNT MIN_PATCH_COUNT MAX_PATCH_COUNT
         MIN_PRIMITIVE_COUNT MAX_PRIMITIVE_COUNT EXPECTED_PALETTE_RESPONSE)
    file(READ "${LOG_PATH}" foliage_log)
    require_log_contains("${LOG_PATH}" "foliageTopology=foliage-meadow-volume-v10")
    require_log_contains("${LOG_PATH}"
        "foliagePalette=${EXPECTED_PALETTE_RESPONSE}")

    string(REGEX MATCH "foliageInstances=([0-9]+)" instance_match "${foliage_log}")
    if(instance_match STREQUAL "")
        message(FATAL_ERROR "Foliage semantic instance count was not reported")
    endif()
    set(instance_count "${CMAKE_MATCH_1}")

    string(REGEX MATCH "foliagePatches=([0-9]+)" patch_match "${foliage_log}")
    if(patch_match STREQUAL "")
        message(FATAL_ERROR "Foliage patch count was not reported")
    endif()
    set(patch_count "${CMAKE_MATCH_1}")

    string(REGEX MATCH "foliagePrimitives=([0-9]+)" primitive_match "${foliage_log}")
    if(primitive_match STREQUAL "")
        message(FATAL_ERROR "Foliage primitive count was not reported")
    endif()
    set(primitive_count "${CMAKE_MATCH_1}")

    string(REGEX MATCH
        "foliageSubmittedVertices=([0-9]+)" submitted_match "${foliage_log}")
    if(submitted_match STREQUAL "")
        message(FATAL_ERROR "Foliage submitted vertex count was not reported")
    endif()
    set(submitted_vertices "${CMAKE_MATCH_1}")

    string(REGEX MATCH
        "foliageVerticesPerPrimitive=([0-9]+)" width_match "${foliage_log}")
    if(width_match STREQUAL "")
        message(FATAL_ERROR "Foliage vertices-per-primitive was not reported")
    endif()
    set(vertices_per_primitive "${CMAKE_MATCH_1}")

    if(instance_count LESS MIN_INSTANCE_COUNT OR
       instance_count GREATER MAX_INSTANCE_COUNT)
        message(FATAL_ERROR
            "Unexpected semantic foliage count: ${instance_count}; expected ${MIN_INSTANCE_COUNT}..${MAX_INSTANCE_COUNT}")
    endif()
    if(patch_count LESS MIN_PATCH_COUNT OR
       patch_count GREATER MAX_PATCH_COUNT OR
       NOT patch_count LESS instance_count)
        message(FATAL_ERROR
            "Unexpected foliage patch count: ${patch_count}; expected ${MIN_PATCH_COUNT}..${MAX_PATCH_COUNT} and fewer than ${instance_count} source plants")
    endif()
    if(primitive_count LESS MIN_PRIMITIVE_COUNT OR
       NOT primitive_count GREATER instance_count OR
       primitive_count GREATER MAX_PRIMITIVE_COUNT)
        message(FATAL_ERROR
            "Unexpected foliage primitive count: ${primitive_count}; expected ${MIN_PRIMITIVE_COUNT}..${MAX_PRIMITIVE_COUNT} and more than ${instance_count}")
    endif()
    math(EXPR expected_submitted_vertices
        "${primitive_count} * ${vertices_per_primitive}")
    if(submitted_vertices EQUAL 0 OR
       NOT submitted_vertices EQUAL expected_submitted_vertices)
        message(FATAL_ERROR
            "Unexpected foliage vertex submission: ${submitted_vertices}; expected ${expected_submitted_vertices}")
    endif()
endfunction()

function(require_windborne_particle_geometry LOG_PATH EXPECTED_ACTIVE_COUNT
         EXPECTED_RESIDENT_COUNT)
    file(READ "${LOG_PATH}" foliage_log)

    string(REGEX MATCH
        "windborneParticles=([0-9]+)" active_match "${foliage_log}")
    if(active_match STREQUAL "")
        message(FATAL_ERROR "Windborne active-particle count was not reported")
    endif()
    set(active_count "${CMAKE_MATCH_1}")

    string(REGEX MATCH
        "windborneResidentParticles=([0-9]+)" resident_match "${foliage_log}")
    if(resident_match STREQUAL "")
        message(FATAL_ERROR "Windborne resident-particle count was not reported")
    endif()
    set(resident_count "${CMAKE_MATCH_1}")

    string(REGEX MATCH
        "windborneSubmittedVertices=([0-9]+)" submitted_match "${foliage_log}")
    if(submitted_match STREQUAL "")
        message(FATAL_ERROR "Windborne submitted-vertex count was not reported")
    endif()
    set(submitted_vertices "${CMAKE_MATCH_1}")

    string(REGEX MATCH
        "windborneResidentGpuBytes=([0-9]+)" bytes_match "${foliage_log}")
    if(bytes_match STREQUAL "")
        message(FATAL_ERROR "Windborne resident-byte count was not reported")
    endif()
    set(resident_bytes "${CMAKE_MATCH_1}")

    math(EXPR expected_submitted_vertices "${active_count} * 36")
    math(EXPR expected_resident_bytes "${resident_count} * 64")
    if(NOT active_count EQUAL EXPECTED_ACTIVE_COUNT OR
       NOT resident_count EQUAL EXPECTED_RESIDENT_COUNT OR
       active_count GREATER resident_count OR
       NOT submitted_vertices EQUAL expected_submitted_vertices OR
       NOT resident_bytes EQUAL expected_resident_bytes)
        message(FATAL_ERROR
            "Unexpected windborne geometry telemetry: active=${active_count}, "
            "resident=${resident_count}, submitted=${submitted_vertices}, "
            "bytes=${resident_bytes}; expected active=${EXPECTED_ACTIVE_COUNT}, "
            "resident=${EXPECTED_RESIDENT_COUNT}, submitted=${expected_submitted_vertices}, "
            "bytes=${expected_resident_bytes}")
    endif()
endfunction()

function(run_runtime EXPECTED_EXIT_CODE WORKING_DIR EXECUTABLE_PATH ASSET_ROOT SCENES_ROOT)
    set(command
        "${EXECUTABLE_PATH}"
        "--no-persist-last-used"
        "--automation-framebuffer-scale-1x")

    if(DEFINED USE_AUTO_EXIT_FRAMES AND USE_AUTO_EXIT_FRAMES)
        list(APPEND command "--auto-exit-frames" "${AUTO_EXIT_FRAMES}")
    else()
        list(APPEND command "--auto-exit-ms" "${AUTO_EXIT_MS}")
    endif()

    if(DEFINED APP_MODE AND NOT APP_MODE STREQUAL "")
        list(APPEND command "--app-mode" "${APP_MODE}")
    endif()
    if(DEFINED UI_SCREEN AND NOT UI_SCREEN STREQUAL "")
        list(APPEND command "--ui-screen" "${UI_SCREEN}")
    endif()
    if(DEFINED AUTOMATION_UI_SCRIPT AND NOT AUTOMATION_UI_SCRIPT STREQUAL "")
        list(APPEND command "--automation-ui-script" "${AUTOMATION_UI_SCRIPT}")
    endif()
    if(DEFINED AUTOMATION_WINDOW_SIZE AND NOT AUTOMATION_WINDOW_SIZE STREQUAL "")
        list(APPEND command "--automation-window-size" "${AUTOMATION_WINDOW_SIZE}")
    endif()
    if(DEFINED RENDER_QUALITY_PRESET AND NOT RENDER_QUALITY_PRESET STREQUAL "")
        list(APPEND command
            "--automation-render-quality-preset" "${RENDER_QUALITY_PRESET}")
    endif()
    if(DEFINED RENDER_SCALE AND NOT RENDER_SCALE STREQUAL "")
        list(APPEND command "--automation-render-scale" "${RENDER_SCALE}")
    endif()
    if(DEFINED SHADOW_RAY_SCALE AND NOT SHADOW_RAY_SCALE STREQUAL "")
        list(APPEND command "--automation-shadow-ray-scale" "${SHADOW_RAY_SCALE}")
    endif()
    if(DEFINED AO_RAY_SCALE AND NOT AO_RAY_SCALE STREQUAL "")
        list(APPEND command "--automation-ao-ray-scale" "${AO_RAY_SCALE}")
    endif()
    if(DEFINED SUN_SHADOW_SAMPLING AND NOT SUN_SHADOW_SAMPLING STREQUAL "")
        list(APPEND command
            "--automation-sun-shadow-sampling" "${SUN_SHADOW_SAMPLING}")
    endif()
    if(DEFINED FIXED_SCENE_TIME_SECONDS AND
       NOT FIXED_SCENE_TIME_SECONDS STREQUAL "")
        list(APPEND command
            "--automation-fixed-scene-time-seconds" "${FIXED_SCENE_TIME_SECONDS}")
    endif()
    if(DEFINED ENABLE_RUNTIME_UI_PIXEL_INSPECT_VALIDATION AND ENABLE_RUNTIME_UI_PIXEL_INSPECT_VALIDATION)
        list(APPEND command "--automation-runtime-ui-pixel-inspect")
    endif()
    if(DEFINED ENABLE_DDA_METRICS_SUMMARY AND ENABLE_DDA_METRICS_SUMMARY)
        list(APPEND command "--automation-log-dda-metrics")
    endif()
    if(DEFINED DISABLE_ALIGNED_PRIMARY_TRAVERSAL AND DISABLE_ALIGNED_PRIMARY_TRAVERSAL)
        list(APPEND command "--automation-disable-aligned-primary-traversal")
    endif()
    if(DEFINED FOLIAGE_RENDERER AND NOT FOLIAGE_RENDERER STREQUAL "")
        list(APPEND command
            "--automation-foliage-renderer" "${FOLIAGE_RENDERER}")
    endif()
    if(DEFINED FOLIAGE_PALETTE AND NOT FOLIAGE_PALETTE STREQUAL "")
        list(APPEND command
            "--automation-foliage-palette" "${FOLIAGE_PALETTE}")
    endif()
    if(DEFINED DISABLE_FOLIAGE_SWAY AND DISABLE_FOLIAGE_SWAY)
        list(APPEND command "--automation-disable-foliage-sway")
    endif()
    if(DEFINED FREEZE_DEBUG AND FREEZE_DEBUG)
        list(APPEND command "--automation-freeze-debug")
    endif()
    if(DEFINED ENABLE_GPU_PROFILE_SUMMARY AND ENABLE_GPU_PROFILE_SUMMARY)
        list(APPEND command
            "--automation-log-gpu-profile"
            "--automation-hide-ui")
        if(DEFINED PROFILE_LIVE_ANIMATION AND PROFILE_LIVE_ANIMATION)
            list(APPEND command "--automation-freeze-camera")
        elseif(DEFINED PRESERVE_TAA_JITTER AND PRESERVE_TAA_JITTER)
            list(APPEND command "--automation-freeze-scene")
        else()
            list(APPEND command "--automation-freeze-debug")
        endif()
        if(DEFINED PROFILE_WARMUP_FRAMES AND NOT PROFILE_WARMUP_FRAMES STREQUAL "")
            list(APPEND command
                "--automation-profile-warmup-frames" "${PROFILE_WARMUP_FRAMES}")
        endif()
        if(DEFINED PROFILE_SAMPLE_FRAMES AND NOT PROFILE_SAMPLE_FRAMES STREQUAL "")
            list(APPEND command
                "--automation-profile-sample-frames" "${PROFILE_SAMPLE_FRAMES}")
        endif()
        if(DEFINED PROFILE_WAIT_FOR_SCENE_READY AND PROFILE_WAIT_FOR_SCENE_READY)
            list(APPEND command "--automation-profile-wait-for-scene-ready")
        endif()
    endif()
    if(DEFINED RECONSTRUCTION_MODE AND NOT RECONSTRUCTION_MODE STREQUAL "")
        list(APPEND command
            "--automation-reconstruction-mode" "${RECONSTRUCTION_MODE}")
    endif()
    if(DEFINED VOXEL_CELL_VARIATION_PRESET AND NOT VOXEL_CELL_VARIATION_PRESET STREQUAL "")
        list(APPEND command
            "--automation-voxel-cell-variation" "${VOXEL_CELL_VARIATION_PRESET}")
    endif()
    if(DEFINED HEMISPHERE_AMBIENT_PRESET AND NOT HEMISPHERE_AMBIENT_PRESET STREQUAL "")
        list(APPEND command
            "--automation-hemisphere-ambient" "${HEMISPHERE_AMBIENT_PRESET}")
    endif()
    if(DEFINED SCENE_ATMOSPHERE_PRESET AND NOT SCENE_ATMOSPHERE_PRESET STREQUAL "")
        list(APPEND command
            "--automation-scene-atmosphere" "${SCENE_ATMOSPHERE_PRESET}")
    endif()
    if(DEFINED LIGHTING_DEBUG_MODE AND NOT LIGHTING_DEBUG_MODE STREQUAL "")
        list(APPEND command
            "--automation-lighting-debug-mode" "${LIGHTING_DEBUG_MODE}")
    endif()
    if(DEFINED DDA_ADVANCED_DEBUG AND NOT DDA_ADVANCED_DEBUG STREQUAL "")
        list(APPEND command
            "--automation-dda-advanced-debug" "${DDA_ADVANCED_DEBUG}")
    endif()
    if(DEFINED DISABLE_EMPTY_SKIP AND DISABLE_EMPTY_SKIP)
        list(APPEND command "--automation-disable-empty-skip")
    endif()
    if(DEFINED DISABLE_PROCEDURAL_FISH AND DISABLE_PROCEDURAL_FISH)
        list(APPEND command "--automation-disable-procedural-fish")
    endif()

    if(DEFINED WAIT_FOR_CLOUD_COMMIT AND WAIT_FOR_CLOUD_COMMIT)
        list(APPEND command "--automation-wait-for-cloud-commit")
    endif()

    if(NOT DEFINED USE_CONTENT_DISCOVERY OR NOT USE_CONTENT_DISCOVERY)
        list(APPEND command
            "--assets" "${ASSET_ROOT}"
            "--scenes" "${SCENES_ROOT}")
    endif()

    if(DEFINED ENABLE_PIXEL_INSPECT_VALIDATION AND ENABLE_PIXEL_INSPECT_VALIDATION)
        list(APPEND command "--automation-pixel-inspect-center")
    endif()
    if(DEFINED ENABLE_PIXEL_INSPECT_HIT_AXIS_VALIDATION AND ENABLE_PIXEL_INSPECT_HIT_AXIS_VALIDATION)
        list(APPEND command "--automation-pixel-inspect-hit-axis")
    endif()
    if(DEFINED PIXEL_INSPECT_POINT AND NOT PIXEL_INSPECT_POINT STREQUAL "")
        list(APPEND command "--automation-pixel-inspect-point" "${PIXEL_INSPECT_POINT}")
    endif()

    if(DEFINED SCENE_NAME AND NOT SCENE_NAME STREQUAL "")
        list(APPEND command "--scene" "${SCENE_NAME}")
    elseif(NOT DEFAULT_SCENE_NAME STREQUAL "")
        list(APPEND command "--scene" "${DEFAULT_SCENE_NAME}")
    endif()

    set(runtime_command ${command})
    if(DEFINED ENABLE_FRAME_CHARACTERIZATION AND ENABLE_FRAME_CHARACTERIZATION)
        set(runtime_command
            ${CMAKE_COMMAND} -E env "DDA_VOXEL_CHARACTERIZE_FRAME=1" ${command})
    endif()

    execute_process(
        COMMAND ${runtime_command}
        WORKING_DIRECTORY "${WORKING_DIR}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout_text
        ERROR_VARIABLE stderr_text
        TIMEOUT 30)

    if(NOT "${result}" STREQUAL "${EXPECTED_EXIT_CODE}")
        message(FATAL_ERROR
            "Unexpected runtime exit code.\nExpected: ${EXPECTED_EXIT_CODE}\nActual: ${result}\n"
            "stdout:\n${stdout_text}\n\nstderr:\n${stderr_text}\n")
    endif()

    string(FIND "${stdout_text}" "Validation Error:" validation_error_index)
    if(NOT validation_error_index EQUAL -1)
        message(FATAL_ERROR
            "Vulkan validation emitted an error during a successful runtime process.\n"
            "stdout:\n${stdout_text}\n\nstderr:\n${stderr_text}\n")
    endif()
endfunction()

set(run_dir "${RUN_DIR}")
set(log_path "${run_dir}/logs/voxel_aquarium.log")
stage_runtime("${BUILD_DIR}" "${EXECUTABLE_PATH}" "${run_dir}" "${ASSET_ROOT}" "${SCENES_ROOT}")

get_filename_component(exe_name "${EXECUTABLE_PATH}" NAME)
set(staged_executable "${run_dir}/${exe_name}")
set(runtime_asset_root "${run_dir}/assets")
set(runtime_scenes_root "${run_dir}/scenes")

if(TEST_CASE STREQUAL "smoke")
    run_runtime("0" "${run_dir}" "${staged_executable}" "${runtime_asset_root}" "${runtime_scenes_root}")
    require_log_contains("${log_path}" "[INFO][Content] Runtime content validation succeeded.")
    require_log_contains("${log_path}" "[INFO][Automation] Auto-exit enabled after")
    require_log_contains("${log_path}" "[INFO][Automation] First frame rendered.")
elseif(TEST_CASE STREQUAL "autodiscovery_smoke")
    set(USE_CONTENT_DISCOVERY ON)
    run_runtime("0" "${run_dir}" "${staged_executable}" "${runtime_asset_root}" "${runtime_scenes_root}")
    require_log_contains("${log_path}" "[INFO][Content] Runtime content validation succeeded.")
    require_log_contains("${log_path}" "[INFO][Automation] First frame rendered.")
elseif(TEST_CASE STREQUAL "render_probe")
    set(ENABLE_PIXEL_INSPECT_VALIDATION ON)
    run_runtime("0" "${run_dir}" "${staged_executable}" "${runtime_asset_root}" "${runtime_scenes_root}")
    require_log_contains("${log_path}" "[INFO][Automation] First frame rendered.")
    require_log_contains("${log_path}" "[INFO][Automation] Pixel inspect validation passed depth=")
    if(DEFINED EXPECTED_RENDER_TARGET AND NOT EXPECTED_RENDER_TARGET STREQUAL "")
        require_log_contains(
            "${log_path}"
            "[INFO][Renderer] Render resolution internal=${EXPECTED_RENDER_TARGET}")
    endif()
    if(DEFINED EXPECTED_EFFECTIVE_RENDER_SCALE AND
       NOT EXPECTED_EFFECTIVE_RENDER_SCALE STREQUAL "")
        if(NOT DEFINED EXPECTED_RENDER_TARGET OR EXPECTED_RENDER_TARGET STREQUAL "" OR
           NOT DEFINED AUTOMATION_WINDOW_SIZE OR AUTOMATION_WINDOW_SIZE STREQUAL "")
            message(FATAL_ERROR
                "Effective render-scale verification requires EXPECTED_RENDER_TARGET and AUTOMATION_WINDOW_SIZE")
        endif()
        require_log_contains(
            "${log_path}"
            "[INFO][Renderer] Render resolution internal=${EXPECTED_RENDER_TARGET} presentation=${AUTOMATION_WINDOW_SIZE} scale=${EXPECTED_EFFECTIVE_RENDER_SCALE}")
    endif()
    if(DEFINED RENDER_QUALITY_PRESET AND NOT RENDER_QUALITY_PRESET STREQUAL "")
        require_log_contains(
            "${log_path}"
            "[INFO][Automation] Render quality preset requested: ${RENDER_QUALITY_PRESET} (")
    endif()
    if(DEFINED SHADOW_RAY_SCALE AND NOT SHADOW_RAY_SCALE STREQUAL "")
        require_log_contains(
            "${log_path}"
            "[INFO][Automation] DDA shadow ray scale requested: ${SHADOW_RAY_SCALE}.")
    endif()
    if(DEFINED AO_RAY_SCALE AND NOT AO_RAY_SCALE STREQUAL "")
        require_log_contains(
            "${log_path}"
            "[INFO][Automation] AO ray scale requested: ${AO_RAY_SCALE}.")
    endif()
    if(DEFINED FIXED_SCENE_TIME_SECONDS AND
       NOT FIXED_SCENE_TIME_SECONDS STREQUAL "")
        require_log_contains(
            "${log_path}"
            "[INFO][Automation] Fixed scene time requested:")
    endif()
    if((DEFINED EXPECTED_SHADOW_RAY_TARGET AND
        NOT EXPECTED_SHADOW_RAY_TARGET STREQUAL "") OR
       (DEFINED EXPECTED_AO_RAY_TARGET AND
        NOT EXPECTED_AO_RAY_TARGET STREQUAL ""))
        if(NOT DEFINED EXPECTED_SHADOW_RAY_TARGET OR
           EXPECTED_SHADOW_RAY_TARGET STREQUAL "" OR
           NOT DEFINED EXPECTED_AO_RAY_TARGET OR
           EXPECTED_AO_RAY_TARGET STREQUAL "" OR
           NOT DEFINED EXPECTED_EFFECTIVE_SHADOW_RAY_SCALE OR
           EXPECTED_EFFECTIVE_SHADOW_RAY_SCALE STREQUAL "" OR
           NOT DEFINED EXPECTED_EFFECTIVE_AO_RAY_SCALE OR
           EXPECTED_EFFECTIVE_AO_RAY_SCALE STREQUAL "" OR
           NOT DEFINED EXPECTED_RENDER_TARGET OR
           EXPECTED_RENDER_TARGET STREQUAL "")
            message(FATAL_ERROR
                "Auxiliary target verification requires both target extents, both effective scales, and EXPECTED_RENDER_TARGET")
        endif()
        require_log_contains(
            "${log_path}"
            "[INFO][Renderer] Auxiliary ray targets: shadow=${EXPECTED_SHADOW_RAY_TARGET} (scale ${EXPECTED_EFFECTIVE_SHADOW_RAY_SCALE}), AO=${EXPECTED_AO_RAY_TARGET} (scale ${EXPECTED_EFFECTIVE_AO_RAY_SCALE}), scene=${EXPECTED_RENDER_TARGET}.")
    endif()
    if(DEFINED EXPECTED_PROFILE_NAME AND NOT EXPECTED_PROFILE_NAME STREQUAL "")
