#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// per-resolve inputs (set 0)
layout(set = 0, binding = 0) uniform sampler2D uCurrent;
layout(set = 0, binding = 1) uniform sampler2D uHistory;
layout(set = 0, binding = 2) uniform sampler2D uVelocity;
layout(set = 0, binding = 3) uniform sampler2D uDepth;
layout(set = 0, binding = 4) uniform sampler2D uNormal;
layout(set = 0, binding = 5) uniform sampler2D uDepthHistory;

// output (single-channel, r16f)
layout(set = 0, binding = 6, r16f) uniform image2D uResolved;

layout(push_constant) uniform PC {
    ivec2 resolution;
    ivec2 currentResolution;
    float blendAlpha;
    float blendAlphaMax;
    float depthRejectThreshold;
    float normalRejectDot;
    float clampSharpness;
    float spatialDepthSigma;
    float spatialValueSigma;
    float spatialNormalPower;
    uint flags;
    uint debugMode;
    uint spatialRadius;
    float _pad0;
} pc;

const uint FLAG_USE_NORMAL_REJECT = 1u;
const uint FLAG_USE_NEIGHBORHOOD = 2u;
const uint FLAG_RESET_HISTORY = 4u;
const uint FLAG_USE_SPATIAL_FILTER = 8u;
const uint FLAG_RECONSTRUCT_CURRENT = 16u;
const uint FLAG_FILTER_RECONSTRUCTED_CURRENT = 32u;

vec3 decodeNormal(vec3 enc) {
    return normalize(enc * 2.0 - 1.0);
}

float reconstructCurrent(ivec2 outputPos, float outputDepth, vec3 outputNormal)
{
    if ((pc.flags & FLAG_RECONSTRUCT_CURRENT) == 0u)
    {
        return texelFetch(uCurrent, outputPos, 0).r;
    }

    vec2 sourcePos = ((vec2(outputPos) + 0.5) / vec2(pc.resolution)) *
                         vec2(pc.currentResolution) -
                     0.5;
    ivec2 sourceBase = ivec2(floor(sourcePos));
    ivec2 sourceMax = pc.currentResolution - ivec2(1);
    float depthSigma = max(pc.spatialDepthSigma, 1e-5);
    float normalPower = max(pc.spatialNormalPower, 1.0);

    float weightedValue = 0.0;
    float weightSum = 0.0;
    float bestValue = 1.0;
    float bestScore = 1e20;
    for (int y = 0; y < 2; ++y)
    {
        for (int x = 0; x < 2; ++x)
        {
            ivec2 sourcePixel = clamp(sourceBase + ivec2(x, y), ivec2(0), sourceMax);
            vec2 sourceUv = (vec2(sourcePixel) + 0.5) / vec2(pc.currentResolution);
            float sampleDepth = texture(uDepth, sourceUv).r;
            vec3 sampleNormal = decodeNormal(texture(uNormal, sourceUv).xyz);
            float normalDot = max(dot(outputNormal, sampleNormal), 0.0);
            float depthDelta = abs(sampleDepth - outputDepth) / depthSigma;
            float score = depthDelta + (1.0 - normalDot) * 2.0;
            float sampleValue = texelFetch(uCurrent, sourcePixel, 0).r;
            if (score < bestScore)
            {
                bestScore = score;
                bestValue = sampleValue;
            }

            vec2 distanceToSample = abs(vec2(sourcePixel) - sourcePos);
            float bilinearWeight = max(1.0 - distanceToSample.x, 0.0) *
                                   max(1.0 - distanceToSample.y, 0.0);
            float depthWeight = exp(-0.5 * depthDelta * depthDelta);
            float normalWeight = pow(normalDot, normalPower);
            float weight = bilinearWeight * depthWeight * normalWeight;
            weightedValue += sampleValue * weight;
            weightSum += weight;
        }
    }

    return weightSum > 1e-5 ? weightedValue / weightSum : bestValue;
}

float bilateralFilterCurrent(ivec2 centerPos, float centerValue, float centerDepth, vec3 centerNormal)
{
    int radius = clamp(int(pc.spatialRadius), 0, 2);
    if (radius <= 0)
    {
        return centerValue;
    }

    ivec2 maxPos = pc.resolution - ivec2(1);
    float spatialSigma = max(float(radius) * 0.85, 0.85);
    float spatialSigma2 = spatialSigma * spatialSigma;
    float depthSigma = max(pc.spatialDepthSigma, 1e-5);
    float valueSigma = max(pc.spatialValueSigma, 1e-4);
    float normalPower = max(pc.spatialNormalPower, 1.0);

    float sum = centerValue;
    float weightSum = 1.0;

    for (int y = -2; y <= 2; ++y) {
        for (int x = -2; x <= 2; ++x) {
            if ((x == 0 && y == 0) || abs(x) > radius || abs(y) > radius) {
                continue;
            }

            ivec2 samplePos = clamp(centerPos + ivec2(x, y), ivec2(0), maxPos);
            float sampleDepth = texelFetch(uDepth, samplePos, 0).r;
            if (sampleDepth >= 0.9999) {
                continue;
            }

            vec3 sampleNormal = decodeNormal(texelFetch(uNormal, samplePos, 0).xyz);
            float sampleValue = reconstructCurrent(samplePos, sampleDepth, sampleNormal);
            float normalDot = max(dot(centerNormal, sampleNormal), 0.0);
            if (normalDot <= 0.0) {
                continue;
            }

            vec2 offset = vec2(x, y);
            float dist2 = dot(offset, offset);
            float spatialWeight = exp(-0.5 * dist2 / spatialSigma2);

            float depthDelta = abs(sampleDepth - centerDepth) / depthSigma;
            float depthWeight = exp(-0.5 * depthDelta * depthDelta);

            float valueDelta = abs(sampleValue - centerValue) / valueSigma;
            float valueWeight = exp(-0.5 * valueDelta * valueDelta);

            float normalWeight = pow(normalDot, normalPower);
            float weight = spatialWeight * depthWeight * valueWeight * normalWeight;
            sum += sampleValue * weight;
            weightSum += weight;
        }
    }

    return sum / max(weightSum, 1e-4);
}

void main() {
    ivec2 pixelPos = ivec2(gl_GlobalInvocationID.xy);
    if (pixelPos.x >= pc.resolution.x || pixelPos.y >= pc.resolution.y) {
        return;
    }

    vec2 uv = (vec2(pixelPos) + 0.5) / vec2(pc.resolution);

    float depth = texture(uDepth, uv).r;
    if (depth >= 0.9999) {
        imageStore(uResolved, pixelPos, vec4(1.0));
        return;
    }

    vec3 centerNormal = decodeNormal(texture(uNormal, uv).xyz);
    float current = reconstructCurrent(pixelPos, depth, centerNormal);
    bool filterReconstructedCurrent =
        (pc.flags & FLAG_FILTER_RECONSTRUCTED_CURRENT) != 0u;
    if ((pc.flags & FLAG_USE_SPATIAL_FILTER) != 0u &&
        ((pc.flags & FLAG_RECONSTRUCT_CURRENT) == 0u || filterReconstructedCurrent)) {
        current = bilateralFilterCurrent(pixelPos, current, depth, centerNormal);
    }

    if ((pc.flags & FLAG_RESET_HISTORY) != 0u) {
        imageStore(uResolved, pixelPos, vec4(current));
        return;
    }

    vec2 velocity = texture(uVelocity, uv).rg;
    vec2 historyUV = uv - velocity;

    bool validHistory = historyUV.x >= 0.0 && historyUV.x <= 1.0 &&
                        historyUV.y >= 0.0 && historyUV.y <= 1.0;

    float rejection = validHistory ? 0.0 : 1.0;
    float history = validHistory ? texture(uHistory, historyUV).r : current;

    if (rejection < 1.0) {
        float historyDepth = texture(uDepthHistory, historyUV).r;
        if (abs(depth - historyDepth) > pc.depthRejectThreshold) {
            rejection = 1.0;
        }
    }

    if (rejection < 1.0 && (pc.flags & FLAG_USE_NORMAL_REJECT) != 0u) {
        vec3 n1 = decodeNormal(texture(uNormal, historyUV).xyz);
        if (dot(centerNormal, n1) < pc.normalRejectDot) {
            rejection = 1.0;
        }
    }

    if (pc.debugMode == 4u) {
        imageStore(uResolved, pixelPos, vec4(rejection));
        return;
    }

    if ((pc.flags & FLAG_USE_NEIGHBORHOOD) != 0u && rejection < 1.0) {
        float minVal = current;
        float maxVal = current;
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                if (x == 0 && y == 0) {
                    continue;
                }
                ivec2 samplePos = clamp(pixelPos + ivec2(x, y), ivec2(0),
                                        pc.resolution - ivec2(1));
                vec2 sampleUv = (vec2(samplePos) + 0.5) / vec2(pc.resolution);
                float sampleDepth = texture(uDepth, sampleUv).r;
                vec3 sampleNormal = decodeNormal(texture(uNormal, sampleUv).xyz);
                float s = reconstructCurrent(samplePos, sampleDepth, sampleNormal);
                minVal = min(minVal, s);
                maxVal = max(maxVal, s);
            }
        }

        if (pc.clampSharpness < 1.0) {
            float center = (minVal + maxVal) * 0.5;
            float halfExtent = (maxVal - minVal) * 0.5;
            halfExtent /= max(pc.clampSharpness, 0.01);
            minVal = center - halfExtent;
            maxVal = center + halfExtent;
        }

        history = clamp(history, minVal, maxVal);
    }

    float alpha = mix(pc.blendAlpha, pc.blendAlphaMax, rejection);
    float resolved = mix(history, current, alpha);
    imageStore(uResolved, pixelPos, vec4(resolved));
}
